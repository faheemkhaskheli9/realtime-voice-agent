# Copy to .env and fill in.
# Leave all three blank to run the agent worker in dry-run mode (in-process
# fake room, no server needed). Set all three to connect to a real LiveKit
# server; setting only some of them is a hard error.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional overrides
LIVEKIT_ROOM=voice-agent-dev
LIVEKIT_AGENT_IDENTITY=agent-worker

# Used by later phases (STT/LLM/TTS)
OPENAI_API_KEY=
